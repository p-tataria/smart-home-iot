# Copy this file to ".env" (same folder as README.md) and edit.
# ---- MQTT broker (public test broker by default; replace with your own later) ----
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt            # mqtt (plain, 1883) | mqtts (TLS, 8883)
MQTT_USERNAME=
MQTT_PASSWORD=

# Must match TOPIC_ROOT in firmware/smart_home.ino.
# On a public broker use something unique, e.g. smart_home_btech_ab12
MQTT_TOPIC_ROOT=smart_home

# ---- Backend ----
PORT=3000
DEVICE_ID=esp32s3-home-01
DB_PATH=./data/smart_home.db
SNAPSHOT_INTERVAL_MS=5000     # how often a sensor_readings row is stored
DEVICE_STALE_MS=30000         # device considered offline if silent this long
RETENTION_DAYS=30             # old rows are deleted automatically
